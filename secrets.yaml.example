# Másold át "secrets.yaml" néven, és töltsd ki. A secrets.yaml NE kerüljön gitbe.
wifi_ssid: "a-wifi-neved"
wifi_password: "a-wifi-jelszavad"

# API titkosítási kulcs: 32 bájt, base64 kódolva.
# Generálás: openssl rand -base64 32   (vagy az ESPHome dashboard készít egyet)
api_key: "IDE_A_GENERALT_KULCS="

# A tartalék hotspot jelszava (legalább 8 karakter)
ap_password: "valami-hosszu-jelszo"
